# ── Stage 1: Build React app ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json yarn.lock* ./
RUN yarn install --frozen-lockfile --legacy-peer-deps 2>/dev/null || \
    npm install --legacy-peer-deps

# Copy source and build
COPY . .
ENV REACT_APP_BACKEND_URL=https://homemeapp.net
ENV DISABLE_ESLINT_PLUGIN=true
ENV NODE_OPTIONS=--max-old-space-size=2048
# Cache buster — ensures rebuild picks up latest source changes
ARG CACHEBUST=1
RUN echo "Build timestamp: $CACHEBUST" && npm run build 2>/dev/null || yarn build

# ── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/build /usr/share/nginx/html

# React Router support
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { try_files $uri $uri/ /index.html; } \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ { \
        expires 1y; add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
