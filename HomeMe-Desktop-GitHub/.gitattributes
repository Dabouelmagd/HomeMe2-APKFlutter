# Git LFS tracking for large files
*.zip filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dmg filter=lfs diff=lfs merge=lfs -text
*.AppImage filter=lfs diff=lfs merge=lfs -text

# Binary files
*.png binary
*.jpg binary
*.ico binary

# Text files with proper line endings
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf